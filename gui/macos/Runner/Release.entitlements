<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox off: this is an internal engineering tool, not an App Store
	     build. Inside the sandbox the app would need
	     com.apple.security.device.usb to reach the board, and the bundled
	     aw-tool helper would inherit the sandbox along with it. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
